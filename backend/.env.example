# Koneksi MySQL. Di Railway isi dengan: ${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://root:password@localhost:3306/tugas_bengkel"

# Secret untuk token login (isi string acak panjang, jangan dibagikan)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Akun admin yang dibuat otomatis saat backend start (jika belum ada)
ADMIN_EMAIL=admin@satra.com
ADMIN_PASSWORD=ganti-password-admin
ADMIN_NAME=Administrator

# API key Claude untuk asisten AI di live chat (opsional; tanpa ini chat langsung diteruskan ke admin)
ANTHROPIC_API_KEY=
